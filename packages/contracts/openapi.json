    "/v1/products": {
      "get": {
        "operationId": "products_v1_products_get",
        "parameters": [
          {
            "description": "Free-text search",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Free-text search",
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 80,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "brand",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 20,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Brand"
            }
          },
          {
            "description": "Minor units",
            "in": "query",
            "name": "min_price",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minor units",
              "title": "Min Price"
            }
          },
          {
            "description": "Minor units",
            "in": "query",
            "name": "max_price",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minor units",
              "title": "Max Price"
            }
          },
          {
            "in": "query",
            "name": "in_stock",
            "required": false,
            "schema": {
              "default": false,
              "title": "In Stock",
              "type": "boolean"
            }
          },
          {
            "description": "Any of these types, e.g. \"milk\", \"yogurt\"",
            "in": "query",
            "name": "product_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 10,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Any of these types, e.g. \"milk\", \"yogurt\"",
              "title": "Product Type"
            }
          },
          {
            "description": "Every one of these tags, e.g. \"organic\", \"fat-free\"",
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 10,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Every one of these tags, e.g. \"organic\", \"fat-free\"",
              "title": "Tag"
            }
          },
          {
            "description": "None of these tags, e.g. \"whole-milk\"",
            "in": "query",
            "name": "exclude_tag",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 10,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "None of these tags, e.g. \"whole-milk\"",
              "title": "Exclude Tag"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortOrder",
              "default": "relevance"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 1000,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 24,
              "maximum": 60,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
