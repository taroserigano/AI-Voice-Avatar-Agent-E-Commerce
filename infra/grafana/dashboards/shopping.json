        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_status_code) (rate(http_server_duration_milliseconds_count{service_name=\"commerce-api\"}[$__rate_interval]))",
          "legendFormat": "{{http_status_code}}"
