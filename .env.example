# Copy to .env (never commit .env). Every value here is a fake placeholder.
# The apps read .env from the repo root. Defaults in code work for local Docker Compose,
# so most lines can stay commented out.

# --- Environment -------------------------------------------------------------------
# dev | test | ci | staging | prod. dev/test/ci seed the development accounts.
APP_ENV=dev

# --- Database -------------------------------------------------------------------------
# This app reads COMMERCE_DATABASE_URL only (never DATABASE_URL, which other projects
# sharing this file may use). Default: the local Docker Compose PostgreSQL.
# For Supabase, use the "Session pooler" string from the dashboard's Connect panel
# (port 5432, works over IPv4); postgres:// and postgresql:// URLs are accepted.
# COMMERCE_DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/commerce
# Integration tests truncate tables, so they always use this separate database instead:
# COMMERCE_TEST_DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/commerce_test

# --- Local services (Docker Compose defaults) ---------------------------------------
# OPENSEARCH_URL=http://localhost:9200

# --- Qdrant (the only vector store; always a real server) --------------------------
# Replaces Pinecone (decision 23). Local: the native binary from `pnpm local:up`.
# Qdrant Cloud: the cluster URL from the dashboard plus a database API key. The key is only
# sent over https. The app writes only to collections it created (metadata owner=ai-commerce).
# QDRANT_URL=http://127.0.0.1:6333      # QDRANT_CLUSTER is accepted as the same setting
# QDRANT_API_KEY=replace_me
# Collections are created in strict mode (as Qdrant Cloud enforces): filters need a payload
# index, declared per corpus in ai_commerce_retrieval.qdrant_collections.CORPUS_FILTERS.
# Embeddings for product and policy text (never customer data). The shared .env names the
# OpenAI key OPEN_AI_API; OPENAI_API_KEY works too.
# OPEN_AI_API=sk-replace-me
# RETRIEVAL_EMBED_MODEL=text-embedding-3-small
# RETRIEVAL_EMBED_DIMENSIONS=1536

# --- Shopping planner (services/planner) --------------------------------------------
# A deepagents planner for multi-step baskets. In-process by default; `a2a` calls the
# internal A2A server (`pnpm dev:planner`, localhost only). Without an OpenAI key it runs
# the labeled scripted planner.
# PLANNER_PROVIDER=auto                 # auto | openai | scripted
# PLANNER_MODEL=gpt-5.5
# PLANNER_SUBAGENT_MODEL=gpt-5.4-mini
# PLANNER_TRANSPORT=inproc              # inproc | a2a
# PLANNER_PORT=8302
# Required outside dev: signs the gateway's 5-minute delegation tokens, and the planner's
# own catalog-only commerce identity.
# PLANNER_DELEGATION_SECRET=replace-with-a-long-random-string
# PLANNER_SERVICE_TOKEN=replace-with-a-long-random-string

# --- Pinecone (being replaced by Qdrant; commerce search still uses it until P3) -------
# Without a key, meaning-based search is reported as "off" and search is keyword-only.
PINECONE_API_KEY=pcsk_replace_me
# This app's own index. It's created automatically with hosted embeddings
# (llama-text-embed-v2) if missing. Don't point this at another project's index:
# the app refuses indexes it didn't create.
PINECONE_INDEX_NAME=ai-commerce
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Suffix for the OpenSearch index and Pinecone namespace: one per developer/environment.
SEARCH_ENV=dev-yourname
# How long search waits for Pinecone before answering with keyword results only.
# SEMANTIC_TIMEOUT_MS=250

# --- Sign-in ---------------------------------------------------------------------------
# Sign-in checks the email and password only. This keys the one-way customer hash on
# telemetry; use a long random value outside local development.
SESSION_SECRET=replace-with-a-long-random-string
# COOKIE_SECURE=false          # true behind HTTPS
# SESSION_TTL_HOURS=12

# --- Telemetry --------------------------------------------------------------------------
# The local OTel Collector from Docker Compose. `pnpm dev` uses it when it's running.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Assistant (Steph, and Xana) -----------------------------------------------------------
# Auto mode uses Claude when its key works, then OpenAI if OPEN_AI_API works, then a clearly
# labeled scripted model. ASSISTANT_MODEL_MODE: auto | claude | openai | scripted.
# ANTHROPIC_API_KEY=sk-ant-replace-me
# ASSISTANT_MODEL=claude-sonnet-5
# ASSISTANT_OPENAI_MODEL=gpt-6-sol
# ASSISTANT_OPENAI_REASONING=medium
# ASSISTANT_MODEL_MODE=auto
# The assistant acts for the signed-in customer with this shared secret (never their cookie).
# The development default is refused outside dev/test/ci: set a long random value there, the
# same in the commerce and assistant services.
# ASSISTANT_SERVICE_TOKEN=replace-with-a-long-random-string
# TypeSafe Jev reads each turn (intent, return reason, which order line, escalation) as typed
# decisions. Without a key, a labeled local simulator answers; JEV_ENABLED=false turns it off.
# TYPESAFE_API_KEY=replace_me
# JEV_ENABLED=true
# JEV_MODEL=jev-latest          # pin e.g. jev-1.13.0 once thresholds are tuned
# Voice (Xana, on /support). Speech-to-text: Deepgram if set, else Groq Whisper, else the
# browser's own recognizer. Text-to-speech: Cartesia if set, else the browser's voice. Audio is
# never stored. Each provider is shown on the page.
# DEEPGRAM_API_KEY=replace_me
# GROQ_API_KEY=replace_me
# CARTESIA_API_KEY=replace_me   # CARTESIA_SONIC_API_KEY also works
# CARTESIA_MODEL=sonic-3.6-2026-08-27
# Xana's face on /support/voice: a Tavus avatar in echo mode (docs/features/10-xana-avatar).
# Off unless VOICE_AVATAR=tavus; the customer still turns Video on per call. Tavus bills per
# minute. `pnpm tavus:setup` makes the echo PAL and prints TAVUS_PAL_ID.
# VOICE_AVATAR=tavus
# TAVUS_APIKEY=replace_me   # TAVUS_API_KEY also works
# TAVUS_PAL_ID=replace_me
# TAVUS_FACE_ID=rc9cff32ceba   # "Anna - Casual" (the default)
# Conversations are stored in the commerce database unless this is set.
# ASSISTANT_DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/commerce

# --- Web ----------------------------------------------------------------------------------
# Use 127.0.0.1, not localhost: on Windows each new connection to localhost waits ~2 s on ::1.
# COMMERCE_API_URL=http://127.0.0.1:8000
# ASSISTANT_API_URL=http://127.0.0.1:8001
# Ports for `pnpm dev`, e.g. to run a second checkout (git worktree) beside the first.
# API_PORT=8000
# ASSISTANT_PORT=8001
# WEB_PORT=3000
# Optional: a Google Maps JavaScript API key (restrict it by HTTP referrer in Google Cloud).
# With it, the store locator shows every store's pin on one map; without it, Google's
# keyless embed shows one store at a time.
# GOOGLE_MAPS_API_KEY=replace_me

# --- Later milestones (not used yet) ------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# LIVEKIT_URL=wss://example.livekit.cloud
# LIVEKIT_API_KEY=replace_me
# LIVEKIT_API_SECRET=replace_me
