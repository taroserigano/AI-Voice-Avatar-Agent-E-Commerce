# Copy to .env (never commit .env). Every value here is a fake placeholder.
# The apps read .env from the repo root. Defaults in code work for local Docker Compose,
# so most lines can stay commented out.

# --- Environment -------------------------------------------------------------------
# dev | test | ci | staging | prod. dev/test/ci seed the development accounts.
APP_ENV=dev

# --- Local services (Docker Compose defaults) ---------------------------------------
# DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/commerce
# REDIS_URL=redis://localhost:6379/0
# OPENSEARCH_URL=http://localhost:9200

# --- Pinecone (always the real service; the only vector store) ----------------------
# Without a key, meaning-based search is reported as "off" and search is keyword-only.
PINECONE_API_KEY=pcsk_replace_me
# This app's own index. It's created automatically with hosted embeddings
# (llama-text-embed-v2) if missing. Don't point this at another project's index:
# the app refuses indexes it didn't create.
PINECONE_INDEX_NAME=ai-commerce
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Suffix for the OpenSearch index and Pinecone namespace: one per developer/environment.
SEARCH_ENV=dev-yourname
# How long search waits for Pinecone before answering with keyword results only.
# SEMANTIC_TIMEOUT_MS=250

# --- Sign-in --------------------------------------------------------------------------
# dev = development sign-in adapter (seeded accounts). oidc = Amazon Cognito (cloud).
AUTH_PROVIDER=dev
# Used for the customer hash on telemetry and signed OIDC state. Use a long random value
# outside local development.
SESSION_SECRET=replace-with-a-long-random-string
# COOKIE_SECURE=false          # true behind HTTPS
# SESSION_TTL_HOURS=12
# WEB_ORIGIN=http://localhost:3000
# OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE
# OIDC_CLIENT_ID=example-client-id
# OIDC_CLIENT_SECRET=example-client-secret
# OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback

# --- Telemetry --------------------------------------------------------------------------
# The local OTel Collector from Docker Compose. `pnpm dev` sets this by default.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Web ----------------------------------------------------------------------------------
# COMMERCE_API_URL=http://localhost:8000

# --- Later milestones (not used yet) ------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# ANTHROPIC_API_KEY=sk-ant-replace-me
# LIVEKIT_URL=wss://example.livekit.cloud
# LIVEKIT_API_KEY=replace_me
# LIVEKIT_API_SECRET=replace_me
# DEEPGRAM_API_KEY=replace_me
# CARTESIA_API_KEY=replace_me
